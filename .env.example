# ============================================================
# सिलाई बही - environment configuration
# Copy this file to `.env` and fill in the values marked TODO.
# The three TODO keys are the only thing you need today.
# How to get each key: see README.md or the build-plan page.
# ============================================================

# --- 1. Anthropic (fallback brain, only needed when BRAIN=claude) ---
# platform.claude.com -> API Keys -> Create Key (add ~$5 credit first)
ANTHROPIC_API_KEY=TODO_sk-ant-...

# --- 2. Sarvam (ears + voice) ---------------------------------
# dashboard.sarvam.ai/key-management -> create API key (free credits on signup)
SARVAM_API_KEY=TODO_...

# --- 3. LiveKit Cloud (the call itself) -----------------------
# cloud.livekit.io -> project `silai-bahi` -> Settings -> API Keys
# You get all three values together.
LIVEKIT_URL=TODO_wss://your-project.livekit.cloud
LIVEKIT_API_KEY=TODO_API...
LIVEKIT_API_SECRET=TODO_...

# --- Tuning (sensible defaults, change later if wanted) -------
# Which LLM drives Suhani: sarvam (Sarvam-105B, launch brain) or claude (fallback).
BRAIN=sarvam
# Claude fallback model (used only when BRAIN=claude).
CLAUDE_MODEL=claude-sonnet-5
# Sarvam brain: bake-off's winning fixed/low config. Don't raise effort - it tested worse.
SARVAM_CHAT_MODEL=sarvam-105b
SARVAM_CHAT_EFFORT=low
SARVAM_CHAT_MAX_TOKENS=1024
# Speech models. Saaras v4 = better Hindi/domain accuracy than v3 (verified on
# our samples). Bulbul v4 is announced but not on the API yet - switch here
# when it lands, after re-auditioning the voice.
SARVAM_STT_MODEL=saaras:v4
SARVAM_TTS_MODEL=bulbul:v3
# Bulbul v3 Hindi voice. Generate samples of all female voices with:
#   python -m silai.voice_demo    (files land in data/voice_demo/)
VOICE_SPEAKER=suhani
# Delivery character: pace >1 = brisker/more upbeat (0.3-3.0), temperature = expressiveness (0.01-2.0)
VOICE_PACE=1.05
VOICE_TEMPERATURE=0.75
# Daily "what's due" push reminder hour (24h clock, IST).
REMINDER_HOUR=8
# SQLite database location.
DB_PATH=data/silai.db

# --- App key (REQUIRED before exposing this to the internet) ---
# Guards every /api/ route and /debug.html. Without it, anyone who finds your
# tunnel or domain can read the whole ledger and mint a LiveKit token that
# joins her room. The server refuses non-localhost requests when it is unset.
# Generate:  .\dev.ps1 genkey     then open once on her phone:  https://host/?k=<key>
APP_KEY=

# --- Web push (reminders) -------------------------------------
# Generated locally, no signup: run  python -m silai.genvapid
# and it prints these three lines for you to paste here.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:suryanshu659@gmail.com
